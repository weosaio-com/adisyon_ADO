{
  "name": "@ado/shared",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js",
      "require": "./dist/menu.cjs"
    },
    "./menu-core": {
      "types": "./dist/menu-core.d.ts",
      "import": "./dist/menu-core.js",
      "require": "./dist/menu-core.cjs"
    },
    "./license": {
      "types": "./dist/license.d.ts",
      "import": "./dist/license.js",
      "require": "./dist/license.cjs"
    },
    "./cloud-api": {
      "types": "./dist/cloud-api.d.ts",
      "import": "./dist/cloud-api.js",
      "require": "./dist/cloud-api.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsup --silent && node --experimental-strip-types src/menu.selfcheck.ts && node --experimental-strip-types src/license.selfcheck.ts && node --experimental-strip-types src/cloud-api.selfcheck.ts"
  },
  "dependencies": {
    "ulid": "^2.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
