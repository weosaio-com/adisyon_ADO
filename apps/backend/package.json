{
  "name": "@ado/backend",
  "version": "0.4.1",
  "private": true,
  "description": "Adisyon/POS yerel backend (NestJS + Prisma/SQLite)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node --transpile-only src/main.ts",
    "seed": "ts-node --transpile-only src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/selfchecks.mjs",
    "test:e2e": "node test/smoke.e2e.mjs",
    "test:e2e:updates": "node test/updates.e2e.mjs",
    "test:e2e:spawned": "node test/run-spawned.mjs"
  },
  "dependencies": {
    "@ado/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@peculiar/x509": "^2.1.0",
    "@prisma/client": "^6.2.0",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
