# ==========================================================================
# Ortam Değişkenleri (ÖRNEK). Gerçek .env dosyası git'e GİRMEZ.
# Kullanım: bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
# ==========================================================================

# --- Veritabanı (Faz 1: SQLite) ---
DATABASE_URL="file:./prisma/dev.db"
ADO_DATA_DIR=""

# --- API ---
API_PORT="3001"
API_TLS_PORT=""              # Tabletler icin yerel HTTPS portu (bos = kapali; paketli surum 43128)
CORS_ORIGINS=""
API_HOST="0.0.0.0"           # LAN'daki Waiter istemcileri için 0.0.0.0

# --- Auth / JWT ---
JWT_ACCESS_SECRET="[JWT_ACCESS_SECRET]"
JWT_REFRESH_SECRET="[JWT_REFRESH_SECRET]"
JWT_ACCESS_TTL="15m"              # Owner access token (ana makine hep bağlı)
JWT_WAITER_ACCESS_TTL="12h"       # Waiter access (tam vardiya; offline'da kilit yok) - OFFLINE_DESIGN.md §12
JWT_REFRESH_TTL="30d"

# --- Giriş güvenliği ---
AUTH_FAILED_LOGIN_MAX="5"         # eşik aşımında hesap kilitlenir
AUTH_LOCK_MINUTES="15"            # kilit süresi (dakika)

# --- Seed (ilk kurulum verisi; ilk çalıştırmada oluşturulur) ---
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="[SEED_OWNER_PASSWORD]"
SEED_OWNER_DISPLAY_NAME="Yönetici"
SEED_WAITER_USERNAME="garson"
SEED_WAITER_DISPLAY_NAME="Garson"
SEED_WAITER_PIN="[4-6 RAKAMLI PIN]"

# --- Lisans (imza doğrulama) — ayrıntı: LICENSING.md ---
# Satıcının Ed25519 açık anahtarı (base64 SPKI DER). Boşsa lisans doğrulanamaz ve zorlanamaz.
# Virgülle birden çok anahtar verilebilir (anahtar değişimi). Paketli sürümde derleme
# profilinden gelir (apps/desktop/profiles). Private key ASLA burada bulunmaz.
ADO_LICENSE_PUBLIC_KEY=""
# Bu kurulumun kalıcı kimliği. Boş = veri dizinindeki ado-install.json (otomatik üretilir).
ADO_INSTALL_ID=""
# Lisans zorunluluğu: 1 açık, 0 kapalı, boş = Ayarlar'daki license.enforce. Paketli sürümde
# derleme profilinden gelir. Lisanssız/süresi geçmiş kurulumda yalnız YENİ adisyon durur.
ADO_LICENSE_ENFORCE=""
# Lisanssız yeni kurulumun deneme süresi (gün). 0 = lisans girilmeden satış yok.
ADO_TRIAL_DAYS="0"
# Lisans bitince yeni adisyonun durmasından önceki ek süre (gün; lisanstaki `g` önceliklidir).
ADO_GRACE_DAYS="7"
# Kilit ekranında gösterilen destek iletişimi (telefon / e-posta).
ADO_SUPPORT_CONTACT=""

# --- Güncelleme paketi imzası ---
# Otomatik güncelleme masaüstü kabuğundadır; açık anahtarlar derleme profilinden gelir
# (apps/desktop/profiles, updatePublicKeys). Backend bu değeri kullanmaz.
UPDATE_PUBLIC_KEY=""

# --- Yedek şifreleme ---
# Paketli sürüm bunu ilk açılışta üretir (userData/secrets.json). Ayarlar > Yedekler'de
# "kurtarma anahtarı" olarak gösterilir; yedeği başka bilgisayarda açmak için gerekir.
BACKUP_ENCRYPTION_KEY="[BACKUP_ENCRYPTION_KEY]"

# --- Loglama ---
LOG_LEVEL="info"             # trace|debug|info|warn|error

# --- QR menü bulutu ---
# Bulutun kök adresi (https; yerelde http://127.0.0.1:8787). Paketli sürümde derleme
# profilinden gelir (apps/desktop/profiles). Ayarlar > QR Menü "QR menüyü aç" bu adrese lisansla
# bağlanır; boşsa kart görünmez.
CLOUD_API_URL=""
# Uzlaştırma aralığı (sn): kaçan yayın, internetsiz açma/kapatma, lisans yenileme, işletme durumu.
CLOUD_RECONCILE_SECONDS="300"
# Heartbeat aralığı (sn): son görülme, sürüm, sağlık bilgisi ve buluttaki lisans durumu.
CLOUD_HEARTBEAT_SECONDS="3600"
# Bulut yedeği denetim aralığı (sn) ve büyük yedeklerde parça boyu (bayt; en az 5 MiB).
CLOUD_BACKUP_INTERVAL_SECONDS="3600"
CLOUD_BACKUP_PART_BYTES="8388608"
